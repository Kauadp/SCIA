{
  "model": {
    "name": "SCIA MLP V2",
    "version": "2.0",
    "task": "Classificação do autor de grupos de 5 mensagens do WhatsApp",
    "num_classes": 13
  },

  "data": {
    "grouping": {
      "method": "5_messages_per_member",
      "group_size": 5,
      "ordering": "chronological_per_member"
    },

    "train_test_split": {
      "test_size": 0.2,
      "stratify": true,
      "random_state": 42
    }
  },

  "preprocessing": {
    "text_cleaning": {
      "lowercase": true,
      "remove_urls": true,
      "remove_whatsapp_artifacts": true,
      "normalize_whitespace": true
    },

    "whatsapp_artifacts_removed": [
      "unknown",
      "null",
      "omitidos",
      "ocultados",
      "imagem",
      "figurinha",
      "audio",
      "vídeo",
      "video",
      "mensagem",
      "apagados",
      "apagadas",
      "media",
      "anexo",
      "voz",
      "documento",
      "contato",
      "editados",
      "editadas"
    ]
  },

  "representations": {
    "tfidf": {
      "analyzer": "char",
      "ngram_range": [
        2,
        5
      ],
      "min_df": 3,
      "max_features": 100000,
      "sublinear_tf": true,
      "artifact": "tfidf/tfidf_vectorizer.joblib"
    },

    "embedding": {
      "model": "paraphrase-multilingual-MiniLM-L12-v2",
      "dimension": 384,
      "normalize_embeddings": true
    }
  },

  "features": {
    "temporal": {
      "hour_start": {
        "encoding": "cyclical",
        "features": [
          "hora_inicio_sin",
          "hora_inicio_cos"
        ],
        "period": 24
      },

      "hour_end": {
        "encoding": "cyclical",
        "features": [
          "hora_fim_sin",
          "hora_fim_cos"
        ],
        "period": 24
      },

      "duration": {
        "feature": "log_duracao",
        "transformation": "logarithmic"
      },

      "day_start": {
        "encoding": "one_hot",
        "drop_first": true,
        "columns_in_order": [
          "dia_inicio_Quarta-feira",
          "dia_inicio_Quinta-feira",
          "dia_inicio_Segunda-feira",
          "dia_inicio_Sexta-feira",
          "dia_inicio_Sábado",
          "dia_inicio_Terça-feira"
        ]
      },

      "day_end": {
        "encoding": "one_hot",
        "drop_first": true,
        "columns_in_order": [
          "dia_fim_Quarta-feira",
          "dia_fim_Quinta-feira",
          "dia_fim_Segunda-feira",
          "dia_fim_Sexta-feira",
          "dia_fim_Sábado",
          "dia_fim_Terça-feira"
        ]
      }
    },

    "stylometry": [
      "qtd_palavras",
      "qtd_caracteres",
      "caracter_por_palavra"
    ]
  },

  "feature_order": [
    "hora_inicio_sin",
    "hora_inicio_cos",
    "hora_fim_sin",
    "hora_fim_cos",
    "log_duracao",

    "dia_inicio_Quarta-feira",
    "dia_inicio_Quinta-feira",
    "dia_inicio_Segunda-feira",
    "dia_inicio_Sexta-feira",
    "dia_inicio_Sábado",
    "dia_inicio_Terça-feira",

    "dia_fim_Quarta-feira",
    "dia_fim_Quinta-feira",
    "dia_fim_Segunda-feira",
    "dia_fim_Sexta-feira",
    "dia_fim_Sábado",
    "dia_fim_Terça-feira",

    "qtd_palavras",
    "qtd_caracteres",
    "caracter_por_palavra",

    "embedding",
    "tfidf"
  ],

  "feature_dimensions": {
    "hora_inicio_sin": 1,
    "hora_inicio_cos": 1,
    "hora_fim_sin": 1,
    "hora_fim_cos": 1,
    "log_duracao": 1,

    "dia_inicio_dummies": 6,
    "dia_fim_dummies": 6,

    "qtd_palavras": 1,
    "qtd_caracteres": 1,
    "caracter_por_palavra": 1,

    "embedding": 384,
    "tfidf": 100000,

    "total": 100404
  },

  "mlp": {
    "architecture": {
      "input_dimension": 100404,
      "hidden_layers": [
        256,
        128
      ],
      "activation": "ReLU",
      "dropout": [
        0.4,
        0.3
      ],
      "output_dimension": 13
    },

    "training": {
      "optimizer": "AdamW",
      "learning_rate": 0.001,
      "weight_decay": 0.0001,
      "batch_size": 256,
      "max_epochs": 20,
      "class_weight": "balanced",
      "validation_split": 0.1,
      "validation_stratified": true,
      "early_stopping": {
        "metric": "macro_f1",
        "patience": 4
      },
      "random_state": 42
    },

    "artifact": "models/scia_mlp_v2.pt"
  },

  "label_encoding": {
    "method": "LabelEncoder",
    "artifact": "models/label_encoder.joblib"
  },

  "artifacts": {
    "model": "models/scia_mlp_v2.pt",
    "label_encoder": "models/label_encoder.joblib",
    "tfidf_vectorizer": "tfidf/tfidf_vectorizer.joblib"
  },

  "selection": {
    "embedding": true,
    "cluster": false,
    "selected_configuration": [
      "tfidf",
      "embedding",
      "temporal_features",
      "stylometric_features"
    ],
    "reason": "A ablação do clustering apresentou melhora de desempenho, enquanto a remoção dos embeddings reduziu o desempenho. A configuração sem clustering e com embeddings apresentou o maior Macro F1 entre as configurações V2 avaliadas."
  },

  "performance": {
    "validation_best_macro_f1": 0.6055,
    "test_accuracy": 0.64,
    "test_macro_f1": 0.5691,
    "test_weighted_f1": 0.64
  }
}